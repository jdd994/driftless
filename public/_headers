# Security headers for Cloudflare Pages. This file is copied verbatim into the
# build output and applied to every response.
#
# The Content-Security-Policy is deliberately strict: Driftless is fully
# self-contained, so nothing here loads or talks to a third party. 'self' for
# scripts and connections means an injected or tampered <script>, or any
# attempt to exfiltrate a passphrase/entry to another origin, is blocked by the
# browser. When sync is added, add the API origin to connect-src (and nothing
# else).
#
# 'wasm-unsafe-eval' is required to run the on-device HEIC→JPEG converter
# (iPhone photos) via WebAssembly. It permits *only* WebAssembly compilation —
# NOT string eval()/new Function() — so it's a narrow relaxation, not the broad
# 'unsafe-eval'. blob: in worker-src covers the converter spawning a worker.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://driftless-server.jdd994.workers.dev; manifest-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
